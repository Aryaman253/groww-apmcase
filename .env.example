# Copy to .env.local for local development. Never commit real values.
# In production these live only in Vercel environment variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts vendor account numbers and payout-provider credentials (AES-256-GCM). Don't change it once data exists.
ENCRYPTION_KEY=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Public base URL, used for vendor-request links and webhook URLs
APP_URL=http://localhost:3000

# Direct pay through a payout provider (test mode only). Defaults to true.
DIRECT_PAY_ENABLED=true

# Direct pay: each real workspace connects its OWN RazorpayX (test) or Cashfree (sandbox)
# account in More → Settings → Payments; credentials are stored encrypted per workspace.
# Demo workspaces use the built-in simulated test rail (fictional accounts, fake money).

# Signs webhooks of the built-in simulated test rail (demo workspaces and tests)
SIMULATED_RAIL_SECRET=
