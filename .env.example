# Copy to .env.local for local development. Never commit real values.
# In production these live only in Vercel environment variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts vendor account numbers and payout-provider credentials (AES-256-GCM). Don't change it once data exists.
ENCRYPTION_KEY=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Public base URL, used for vendor-request links and webhook URLs
APP_URL=http://localhost:3000

# Direct pay through a payout provider (test mode only). Defaults to true.
DIRECT_PAY_ENABLED=true

# RazorpayX test-mode keys used ONLY by demo workspaces (fake money).
# Real workspaces connect their own provider account in Settings → Payments.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Optional: Cashfree Payouts sandbox for the demo (otherwise configure per workspace)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Signs webhooks of the built-in simulated test rail (used when no provider keys are set)
SIMULATED_RAIL_SECRET=
